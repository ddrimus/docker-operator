# Docker Operator: copy to .env, set WEBHOOK_SECRET (and empty SOPS_AGE_KEY_FILE without secrets)
# Variables: https://github.com/ddrimus/docker-operator#configuration

TZ=UTC
GIT_REPO_URL=/repository/stacks
GIT_BRANCH=main
COMPOSE_SUBDIR=compose
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=changeme_generate_with_openssl_rand_hex_32
SOPS_AGE_KEY_FILE=/run/secrets/sops_age.key
REGISTRY_HOST=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
PULL_IMAGES=true
PRUNE_REMOVED_STACKS=false
POLL_INTERVAL_SECONDS=300
DEPLOY_TIMEOUT_SECONDS=300
DEPLOY_MAX_RETRIES=3
DEPLOY_RETRY_DELAY_SECONDS=60
DEPLOY_PRIORITY=
DEPLOY_UID=
DEPLOY_GID=
NOTIFY_WEBHOOK_URL=
LOG_LEVEL=INFO
