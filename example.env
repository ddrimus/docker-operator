# Required. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=changeme_generate_with_openssl_rand_hex_32

# HTTP path the Forgejo webhook posts to, must match the webhook config in Forgejo
WEBHOOK_PATH=/webhook

# Required. Local filesystem path to Forgejo's bind-mounted bare repo storage (see compose.yaml, README), a network URL also works
GIT_REPO_URL=/mnt/forgejo-repo

# Branch reconciled against
GIT_BRANCH=main

# Subdirectory of the repo holding per-stack compose folders
COMPOSE_SUBDIR=compose

# Path (inside the container) to the age private key used to decrypt sops secrets; leave unset if no stack uses sops
SOPS_AGE_KEY_FILE=/run/secrets/age_key

# Run `docker compose pull` before `up` on every deploy
PULL_IMAGES=true

# Tear down a stack's containers when its folder is removed from the repo
PRUNE_REMOVED_STACKS=false

# Full resync interval, self-heals a missed or failed webhook
POLL_INTERVAL_SECONDS=300

LOG_LEVEL=INFO

# Optional. How long a single git/sops/docker-compose command may run before it's treated as failed
DEPLOY_TIMEOUT_SECONDS=300

# Optional. Discord-compatible webhook URL for validate/deploy/teardown failure notifications, unset disables it (default)
NOTIFY_WEBHOOK_URL=
